{
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2024"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src"
  ]
}
