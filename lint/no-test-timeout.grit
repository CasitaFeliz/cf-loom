language js

or {
  `$runner($name, $body, $limit)` where {
    $runner <: r"(?s)(?:test|it|describe|suite)(?:[.(].*)?",
    $body <: not JsObjectExpression(),
    $limit <: not or {
      JsArrowFunctionExpression(),
      JsFunctionExpression()
    }
  },
  `$runner($name, $options, $body)` where {
    $runner <: r"(?s)(?:test|it|describe|suite)(?:[.(].*)?",
    $options <: JsObjectExpression(members=$members),
    $members <: some or {
      `timeout: $_`,
      JsShorthandPropertyObjectMember(name=`timeout`)
    }
  },
  `$hook($body, $limit)` where {
    $hook <: r"beforeAll|afterAll|beforeEach|afterEach|aroundAll|aroundEach|onTestFailed|onTestFinished"
  },
  `vi.setConfig($config)`
} as $call where {
  $filename <: r".*\.test\.ts$",
  register_diagnostic(span=$call, message="C30: a test, suite or hook gets the hang bound, never a timeout of its own.", severity="error")
}
