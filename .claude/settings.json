{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/one-question.ts\"",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/shared-state-commands.ts\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.npmrc)",
      "Bash(git stash:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(npx:*)"
    ]
  }
}
