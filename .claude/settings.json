{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          { "command": "node \"$CLAUDE_PROJECT_DIR/scripts/one-question.ts\"", "type": "command" }
        ],
        "matcher": "AskUserQuestion"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.npmrc)",
      "Bash(git stash:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(npx:*)"
    ]
  }
}
