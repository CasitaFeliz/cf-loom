{
  "name": "@cf-loom/server",
  "version": "1.0.0-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasitaFeliz/cf-loom.git",
    "directory": "packages/server"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-http": {
      "types": "./dist/node-http/index.d.ts",
      "default": "./dist/node-http/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "devDependencies": {
    "@cf-loom/contract": "workspace:^",
    "@cf-loom/handlers": "workspace:^",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@cf-loom/contract": "workspace:^",
    "@cf-loom/handlers": "workspace:^",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
