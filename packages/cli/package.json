{
  "name": "@cf-loom/cli",
  "version": "1.0.0-rc.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasitaFeliz/cf-loom.git",
    "directory": "packages/cli"
  },
  "license": "(MIT OR Apache-2.0)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
